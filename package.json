{
  "name": "web-online-games",
  "version": "0.1.0",
  "private": true,
  "description": "Онлайн-платформа игр для двоих: авторитетный сервер на Colyseus + клиент на ванильном HTML/CSS/JS",
  "type": "commonjs",
  "main": "build/index.js",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc",
    "start": "node build/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test server/**/*.test.ts",
    "clean": "rm -rf build"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@colyseus/core": "0.16.24",
    "@colyseus/schema": "^3.0.76",
    "@colyseus/ws-transport": "^0.16.5",
    "colyseus.js": "^0.16.22",
    "dotenv": "^17.4.2",
    "express": "^4.22.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.23",
    "@types/node": "^22.10.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
