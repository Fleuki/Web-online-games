# Порт HTTP/WebSocket сервера
PORT=2567

# Хост, на котором слушает сервер.
# 0.0.0.0 — доступен извне: нужно для Railway / Fly.io / Docker
# и чтобы открыть лобби с телефона в локальной сети.
HOST=0.0.0.0

# Игра, которая запускается в комнате по умолчанию (id из server/games/registry.ts)
DEFAULT_GAME=treegame

# Сколько секунд ждать игрока после обрыва связи, прежде чем засчитать поражение
RECONNECT_TIMEOUT=60
